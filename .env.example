# Production Environment Variables for SkateHive 3.0
# Copy this file to .env.local and fill in the actual values

# Application Settings
NEXT_PUBLIC_COMMUNITY_NAME=skatehive
NEXT_PUBLIC_DOMAIN=skatehive.app
NEXT_PUBLIC_BASE_URL=https://skatehive.app
NEXT_PUBLIC_THEME=hacker

# Hive Blockchain
NEXT_PUBLIC_HIVE_COMMUNITY_TAG=hive-173115
NEXT_PUBLIC_HIVE_SEARCH_TAG=hive-173115
NEXT_PUBLIC_HIVE_USER=skatehive
HIVE_POSTING_KEY=your_hive_posting_key_here

# =============================================================================
# USERBASE AUTHENTICATION SYSTEM
# =============================================================================

# Supabase (Database - Required for Userbase)
NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# Lite Account Posting (shared account for email-only users)
DEFAULT_HIVE_POSTING_ACCOUNT=skateuser
DEFAULT_HIVE_POSTING_KEY=5xxx...

# Userbase Key Encryption (AES-256-GCM, 64 hex chars)
# CRITICAL: Never change this after deployment or encrypted keys become unrecoverable
ENCRYPTION_KEY=your_64_hex_character_key_here

# Hive Active Key (for sponsored account creation via Keychain fallback)
HIVE_ACTIVE_KEY=5xxx...

# Email (for magic links and key backups via Resend)
RESEND_API_KEY=re_xxx...
RESEND_FROM_EMAIL=noreply@skatehive.app

# Session Security
JWT_SECRET=random_string_at_least_32_chars

# Neynar API (for Farcaster profile fetching)
NEYNAR_API_KEY=your_neynar_api_key_here

# =============================================================================
# END USERBASE SECTION
# =============================================================================

# Database (Optional, for Farcaster notifications)
STORAGE_POSTGRES_URL=....

# Farcaster notifications
FARCASTER_INIT_PASSWORD=your_secure_password_for_database_init

# Web3 & Wallets
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key
NEXT_PUBLIC_CDP_PROJECT_ID=your_coinbase_developer_platform_project_id

# DAO Contracts
NEXT_PUBLIC_TOKEN=0xfe10d3ce1b0f090935670368ec6de00d8d965523
NEXT_PUBLIC_METADATA=0xea34d6f46ecc15bdf5c59fb26a8176262d18560f
NEXT_PUBLIC_AUCTION=0x599f3724129ab678986a948a63ecb42fcc873a43
NEXT_PUBLIC_TREASURY=0x4c5086086fda01fb8fcffe491862e7504984a75f
NEXT_PUBLIC_GOVERNOR=0x3b7c72033cf4d8c5c85d58612a6661c2d70f4010

# Zora API
NEXT_PUBLIC_ZORA_API_KEY=your_zora_api_key

# Thread Settings
NEXT_PUBLIC_THREAD_AUTHOR=your_thread_author_here
NEXT_PUBLIC_THREAD_PERMLINK=your_thread_permlink_here

# Production Settings
NODE_ENV=production

# =============================================================================
# LI.FI BRIDGE (cross-chain bridge in the Swap tab)
# =============================================================================
# Integrator string registered at https://portal.li.fi. REQUIRED for the 0.5%
# integrator fee: when empty, /api/lifi/quote sends NO integrator and NO fee
# and the bridge silently works for free (this is what happened before Aug 2026).
# NOTE: the portal integration is *named* "skatehive" but its integration-string
# is "gnars". Fee wallet is configured in the portal (SkateHive split 0x1c04…5F21).
LIFI_INTEGRATOR=gnars
# Integrator fee in basis points (50 = 0.5%). LI.FI keeps a share of this.
LIFI_FEE_BPS=50
# Optional: raises LI.FI rate limits. Not needed for fee collection.
LIFI_API_KEY=
