# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local
.env*
# keep the documented template tracked — a required env var that appears
# nowhere is exactly how the LI.FI fee silently never got collected
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# build artifacts and performance cache
node_modules/.cache
.pnpm-debug.log*
.eslintcache
.next/cache
.swc/

# OS-specific files
Thumbs.db

# MCP config with API keys
.vscode/mcp.json

# Claude
.claude/

.mcp.json
